{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "id": "f2b103f1-1ab1-4e1b-8f0b-072aa3d4e19d",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "name": {
    "short": "Conectado Task Pane Add-in",
    "full": "Conectado Task Pane Add-in"
  },
  "description": {
    "short": "Manage meeting mappings and recordings.",
    "full": "Conectado helps you map meetings to projects and automatically process recordings from your inbox."
  },
  "developer": {
    "name": "Conectado",
    "websiteUrl": "https://www.Conectado.com",
    "privacyUrl": "https://www.sigmasoft.ai/privacy-policy#Contact-Us",
    "termsOfUseUrl": "https://www.Conectado.com/servicesagreement"
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#230201",
  "localizationInfo": {
    "defaultLanguageTag": "en-us",
    "additionalLanguages": []
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Mailbox.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": [
    "Conectado.com"
  ],
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "mail"
        ],
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.3"
          }
        ]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.3"
              }
            ]
          },
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://prod.sigmasoftinfotech.com/connectado_outlook/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "TaskPaneRuntimeShow",
              "type": "openPage",
              "pinnable": false,
              "view": "dashboard"
            }
          ]
        },
        {
          "id": "CommandsRuntime",
          "type": "general",
          "code": {
            "page": "https://prod.sigmasoftinfotech.com/connectado_outlook/commands.html",
            "script": "https://prod.sigmasoftinfotech.com/connectado_outlook/commands.js"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "action",
              "type": "executeFunction"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "mailCompose"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "msgComposeGroup",
                  "label": "Conectado Add-in",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "msgComposeOpenPaneButton",
                      "type": "button",
                      "label": "Show Task Pane",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Show Task Pane",
                        "description": "Opens a task pane."
                      },
                      "actionId": "TaskPaneRuntimeShow"
                    },
                    {
                      "id": "ActionButton",
                      "type": "button",
                      "label": "Perform an action",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://prod.sigmasoftinfotech.com/connectado_outlook/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Perform an action",
                        "description": "Perform an action when clicked."
                      },
                      "actionId": "action"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}